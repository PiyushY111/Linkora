# Linkora frontend configuration

# Origin of the backend API, without /api.
# - Local development: leave empty. The Vite dev server proxies /api to
#   http://localhost:5001 (vite.config.js).
# - Production: the deployed API origin, e.g. https://api.example.com. That
#   backend must list this frontend in FRONTEND_URL or ALLOWED_ORIGINS.
VITE_API_URL=

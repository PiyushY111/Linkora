# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/linkly?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops in front of this app (0 if none)
TRUST_PROXY_HOPS=1

# Cloudinary (for QR code storage and image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Custom Domain
CUSTOM_DOMAIN_API=your_domain_api_key

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging / metrics
LOG_LEVEL=info
METRICS_TOKEN=

# Redis (cache, counters, streams)
# Non-evictable Redis: refresh tokens, rate limits, streams, usage counters.
# Run this instance with maxmemory-policy noeviction.
REDIS_URL=redis://127.0.0.1:6379
# Evictable Redis cache for link:meta:{shortCode} only. Optional - falls
# back to REDIS_URL when unset (fine for local dev with a single Redis).
# Safe to run maxmemory-policy allkeys-lru on this one.
# REDIS_CACHE_URL=redis://127.0.0.1:6380
REDIS_CACHE_TTL_SECONDS=86400
REDIS_NEGATIVE_CACHE_TTL_SECONDS=120
CLICK_STREAM_KEY=stream:clicks
CLICK_STREAM_CONSUMER_GROUP=click-consumers
CLICK_STREAM_BATCH_SIZE=500
CLICK_STREAM_BATCH_INTERVAL_MS=1000
WEBHOOK_DLQ_STREAM_KEY=stream:webhooks:dlq

# Falls back to JWT_SECRET when unset
LINK_SEQUENCE_CIPHER_KEY=

# ClickHouse (analytics store)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=linkly
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# GeoIP (MaxMind GeoLite2 - local .mmdb file + optional auto-updater)
GEOIP_DB_PATH=
GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=
GEOIP_EDITION_ID=GeoLite2-City

# Threat detection (malicious URL scanning)
SAFE_BROWSING_ENABLED=false
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=

# Enterprise SSO (WorkOS)
SSO_ENABLED=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=

# Webhooks
WEBHOOK_SIGNING_SECRET=
